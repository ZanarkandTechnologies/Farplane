# Copy this file to ~/.codex/config.local.env and fill in machine-local values.
# This file is not tracked and is used by install.sh to render ~/.codex/config.toml.

CODEX_HOME=__CODEX_HOME__
REF_API_KEY=YOUR_REF_API_KEY
NOTION_TOKEN=YOUR_NOTION_TOKEN

# Optional Farplane UI Convex telemetry endpoint for Codex lifecycle hooks.
# Use the Convex site URL, not the Convex client URL.
FARPLANE_CONVEX_SITE_URL=
FARPLANE_TELEMETRY_TOKEN=
FARPLANE_CONSOLE_KEY=
FARPLANE_ACTIVITY_RECENT_URL=
