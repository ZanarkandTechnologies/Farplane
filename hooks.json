{
  "description": "Farplane: independent continuation and response-length gates; classified lifecycle telemetry is observational, never completion authority.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.codex/bin/capture_user_turn.py\"",
            "statusMessage": "User intent — captures current request and optional skill suggestion",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "python3 \"$HOME/.codex/hooks/farplane_console_ping.py\" --expect-event UserPromptSubmit",
            "statusMessage": "Telemetry — user turn started (observation only)",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(apply_patch|Edit|Write)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.codex/hooks/skill_file_line_gate.py\"",
            "statusMessage": "Skill length — checks edited SKILL.md files against 200 lines",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.codex/hooks/continuation_gate.py\"",
            "statusMessage": "Continuation — Jev checks whether useful authorized work remains",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "python3 \"$HOME/.codex/hooks/final_response_gate.py\"",
            "statusMessage": "Response length — requests rewrite above configured prose limits",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "python3 \"$HOME/.codex/hooks/farplane_console_ping.py\" --expect-event Stop",
            "statusMessage": "Telemetry — stop attempted (not task completion)",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.codex/hooks/farplane_console_ping.py\" --expect-event SubagentStart",
            "statusMessage": "Telemetry — subagent started (observation only)",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.codex/hooks/farplane_console_ping.py\" --expect-event SubagentStop",
            "statusMessage": "Telemetry — subagent stopped (not parent completion)",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
