{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.codex/hooks/shared_checkout_guard.py\"",
            "statusMessage": "Checking shared checkout ownership",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "python3 \"$HOME/.codex/bin/capture_user_turn.py\"",
            "statusMessage": "Capturing current-turn user intent",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "python3 \"$HOME/.codex/hooks/farplane_console_ping.py\"",
            "statusMessage": "Sending Farplane Console start heartbeat",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(apply_patch|Edit|Write)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.codex/hooks/skill_file_line_gate.py\"",
            "statusMessage": "Checking edited skill length",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.codex/hooks/final_response_gate.py\"",
            "statusMessage": "Checking final response budget",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "python3 \"$HOME/.codex/hooks/shared_checkout_guard.py\"",
            "statusMessage": "Releasing shared checkout ownership",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "python3 \"$HOME/.codex/hooks/farplane_console_ping.py\"",
            "statusMessage": "Sending Farplane Console stop heartbeat",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.codex/hooks/farplane_console_ping.py\"",
            "statusMessage": "Sending Farplane subagent start",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.codex/hooks/farplane_console_ping.py\"",
            "statusMessage": "Sending Farplane subagent stop",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
