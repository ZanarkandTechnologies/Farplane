{
  "description": "Farplane: one blocking Stop gate (length, continuation, response format; at most one nudge per stop); classified lifecycle telemetry is observational, never completion authority.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.codex/hooks/user-turn/capture_user_turn.py\"",
            "statusMessage": "User intent — captures current request and optional skill suggestion",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "python3 \"$HOME/.codex/hooks/lifecycle-telemetry/farplane_console_ping.py\" --expect-event UserPromptSubmit",
            "statusMessage": "Telemetry — user turn started (observation only)",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(apply_patch|Edit|Write)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.codex/hooks/skill-length/skill_file_line_gate.py\"",
            "statusMessage": "Skill length — checks edited SKILL.md files against 200 lines",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.codex/hooks/stop-gate/stop_gate.py\"",
            "statusMessage": "Stop gate — length, then continuation, then response format; at most one nudge",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "python3 \"$HOME/.codex/hooks/lifecycle-telemetry/farplane_console_ping.py\" --expect-event Stop",
            "statusMessage": "Telemetry — stop attempted (not task completion)",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.codex/hooks/lifecycle-telemetry/farplane_console_ping.py\" --expect-event SubagentStart",
            "statusMessage": "Telemetry — subagent started (observation only)",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.codex/hooks/lifecycle-telemetry/farplane_console_ping.py\" --expect-event SubagentStop",
            "statusMessage": "Telemetry — subagent stopped (not parent completion)",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
