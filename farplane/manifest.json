{
  "schema": "farplane_project",
  "spec_version": "2.0.18",
  "template_uses": {
    "farplane-framework": "2.0.18"
  },
  "project": {
    "name": "Farplane",
    "description": "Autonomous AI harness lab for making Codex work visible, reviewable, repeatable, and evidence-improving.",
    "archetype": "autonomous_ai_harness_lab"
  },
  "standard": {
    "tracked": [
      "AGENTS.md",
      ".gitignore",
      "ARCHITECTURE.md",
      "farplane/README.md",
      "farplane/manifest.json",
      "farplane/harness.yaml",
      "farplane/metrics.yaml",
      "farplane/automations/",
      "farplane/bindings.yaml",
      ".agents/skills/README.md",
      "docs/prd.md",
      "docs/HISTORY.md",
      "docs/MEMORY.md",
      "tickets/README.md",
      "tickets/templates/ticket.md",
      "tickets/archive/"
    ],
    "ignored": [
      ".farplane/README.md",
      ".farplane/content/",
      ".farplane/metrics/daily/",
      ".farplane/project/ui/",
      ".farplane/reports/",
      ".farplane/views.yaml",
      ".farplane/entities/",
      ".farplane/wiki/",
      ".farplane/evals/runs/",
      ".farplane/events/",
      ".farplane/logs/",
      ".farplane/mine/",
      ".farplane/state/"
    ]
  },
  "optional": {
    "tracked": [
      "farplane/pm.json",
      ".githooks/README.md",
      ".githooks/pre-commit",
      ".githooks/pre-push",
      "bin/validators/run_git_gate.py",
      "config/git-review-gates.toml",
      "skills/code-health/SKILL.md",
      "skills/review/SKILL.md"
    ],
    "ignored": []
  },
  "farplane_graph": {
    "framework_core": {
      "include": [
        "docs/guides/README.md",
        "docs/guides/work-loop.md",
        "skills/setup-advisor/references/critical-path.md",
        "docs/guides/project-files.md",
        "docs/guides/graphs.md",
        "docs/guides/hooks-and-runtime.md",
        "skills/harness/references/harness-maintenance.md",
        "docs/guides/wiki-and-entities.md",
        "docs/guides/reporting.md",
        "docs/guides/cli.md"
      ],
      "exclude": [
        "tickets/archive/**",
        ".farplane/reports/**",
        ".farplane/logs/**"
      ]
    }
  },
  "_template_metadata": {
    "template_id": "farplane-framework",
    "template_version": "2.0.18",
    "consumer_scope": "project",
    "applies_to": [
      "farplane/manifest.json"
    ]
  }
}
