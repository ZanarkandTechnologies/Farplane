{
  "schema": "farplane_project",
  "spec_version": "1.3.0",
  "template_uses": {
    "farplane-framework": "1.3.0"
  },
  "standard": {
    "tracked": [
      "AGENTS.md",
      "PROJECT_RULES.md",
      "ARCHITECTURE.md",
      "farplane/README.md",
      "farplane/manifest.json",
      "farplane/harness.md",
      "farplane/goals.md",
      "farplane/automations.md",
      "farplane/bindings.md",
      "farplane/evals.md",
      "docs/bootstrap-brief.md",
      "docs/prd.md",
      "docs/specs/README.md",
      "docs/HISTORY.md",
      "docs/MEMORY.md",
      "docs/TASTE.md",
      "docs/TROUBLES.md",
      "docs/LESSONS.md",
      "qa/README.md",
      "qa/AGENTS.md",
      "qa/cookbook/README.md",
      "qa/cookbook/TEMPLATE.md",
      "tickets/README.md",
      "tickets/templates/ticket.md",
      "tickets/archive/"
    ],
    "ignored": [
      ".farplane/README.md",
      ".farplane/state/run-ledger.json",
      ".farplane/reports/",
      ".farplane/evals/runs/",
      ".farplane/logs/"
    ]
  },
  "optional": {
    "tracked": [
      "farplane/pm.json",
      ".githooks/README.md",
      ".githooks/pre-commit",
      ".githooks/pre-push",
      "scripts/pre_commit_check.sh",
      "scripts/pre_push_check.sh",
      "docs/code_review.md",
      "docs/review-agent.md",
      "scripts/collect_review_context.sh",
      "scripts/codex_review_agent.ts",
      "scripts/run_pre_push_review.sh"
    ],
    "ignored": [
      ".farplane/reviews/"
    ]
  },
  "farplane_graph": {
    "framework_core": {
      "include": [
        "docs/farplane-framework/README.md",
        "docs/farplane-framework/lifecycle.md",
        "docs/farplane-framework/deep-init-critical-path.md",
        "docs/farplane-framework/project-files.md",
        "docs/farplane-framework/graph-contract.md",
        "docs/farplane-framework/hooks-and-runtime.md",
        "docs/farplane-framework/harness-maintenance.md"
      ],
      "exclude": [
        "farplane/products.md",
        "tickets/archive/**",
        ".farplane/reports/**",
        ".farplane/logs/**",
        "experiments/**"
      ]
    }
  }
}
