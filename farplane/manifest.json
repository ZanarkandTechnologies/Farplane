{
  "schema": "farplane_project",
  "spec_version": "2.0.4",
  "template_uses": {
    "farplane-framework": "2.0.4"
  },
  "project": {
    "name": "Farplane",
    "description": "Autonomous AI harness lab for making Codex work visible, reviewable, repeatable, and evidence-improving.",
    "archetype": "autonomous_ai_harness_lab"
  },
  "standard": {
    "tracked": [
      "AGENTS.md",
      ".gitignore",
      "PROJECT_RULES.md",
      "ARCHITECTURE.md",
      "farplane/README.md",
      "farplane/manifest.json",
      "farplane/harness.yaml",
      "farplane/metrics.yaml",
      "farplane/automations.toml",
      "farplane/bindings.yaml",
      ".agents/skills/README.md",
      "docs/bootstrap-brief.md",
      "docs/prd.md",
      "docs/features/README.md",
      "docs/systems/README.md",
      "docs/HISTORY.md",
      "docs/MEMORY.md",
      "docs/TASTE.md",
      "docs/TROUBLES.md",
      "docs/LESSONS.md",
      "qa/README.md",
      "qa/AGENTS.md",
      "qa/cookbook/README.md",
      "qa/cookbook/TEMPLATE.md",
      "tickets/README.md",
      "tickets/templates/ticket.md",
      "tickets/archive/"
    ],
    "ignored": [
      ".farplane/README.md",
      ".farplane/content/",
      ".farplane/metrics/daily/",
      ".farplane/project/ui/",
      ".farplane/reports/",
      ".farplane/crm/",
      ".farplane/evals/runs/",
      ".farplane/events/",
      ".farplane/logs/",
      ".farplane/mine/",
      ".farplane/state/"
    ]
  },
  "optional": {
    "tracked": [
      "farplane/hooks.json",
      "farplane/pm.json",
      ".githooks/README.md",
      ".githooks/pre-commit",
      ".githooks/pre-push",
      "bin/validators/run_git_gate.py",
      "rules/git-review-gates.toml",
      "skills/code-review/SKILL.md",
      "skills/review/SKILL.md"
    ],
    "ignored": []
  },
  "farplane_graph": {
    "framework_core": {
      "include": [
        "docs/farplane-framework/README.md",
        "docs/farplane-framework/lifecycle.md",
        "docs/farplane-framework/init-advisor-critical-path.md",
        "docs/farplane-framework/project-files.md",
        "docs/farplane-framework/graph-contract.md",
        "docs/farplane-framework/hooks-and-runtime.md",
        "docs/farplane-framework/harness-maintenance.md",
        "docs/farplane-framework/crm.md",
        "docs/farplane-framework/reporting.md"
      ],
      "exclude": [
        "tickets/archive/**",
        ".farplane/reports/**",
        ".farplane/logs/**"
      ]
    }
  }
}
