{
  "schema_version": 1,
  "program_ref": "core:ticket-completion-learning@1.1.0",
  "program_id": "ticket-completion-learning",
  "version": "1.1.0",
  "kind": "ticket_completion_learning",
  "objective": "Extract compact reusable problems and solutions from one completed ticket packet and its bounded associated operator-turn window.",
  "required_inputs": [
    "event_source",
    "operator_turn_window"
  ],
  "optional_inputs": [
    "program",
    "progress",
    "artifact"
  ],
  "report_schema_version": 2,
  "executor": {
    "kind": "codex_exec",
    "model": "gpt-5.4-mini",
    "reasoning_effort": "low",
    "profile": "",
    "timeout_seconds": 180,
    "sandbox": "read-only",
    "hooks": "disabled"
  },
  "ticket_projection": {
    "enabled": true,
    "max_tickets": 1,
    "minimum_confidence": "medium",
    "status": "todo",
    "missing_kpi_status": "awaiting_review"
  },
  "instructions": [
    "Find operator corrections, repeated friction, missing reusable workflows, and successful patterns worth making repeatable.",
    "Order material findings strongest and most actionable first because Core may project only the first grounded finding into a local ticket.",
    "Give each finding a stable semantic dedupe_key of two to eight lowercase snake_case terms that names the underlying problem or reusable pattern, not the proposed implementation or source ticket.",
    "A finding may recommend a skill, policy, docs, automation, hook, validator, feature, or no durable change.",
    "Set recovery_eligible true only for an evidenced existing failure with a known direct correction that needs no experiment.",
    "Mark uncertain improvements recovery_eligible false so their projected ticket proves or rejects the idea before adoption.",
    "Return no finding when the evidence is one-off, weak, already owned, or merely restates completed work."
  ],
  "privacy": {
    "source_snapshot": "local_bounded_only",
    "raw_transcript_output": "forbidden",
    "quotes": "forbidden",
    "external_write": "forbidden"
  },
  "output_schema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "status",
      "summary",
      "material_findings",
      "source_gaps",
      "escalation"
    ],
    "properties": {
      "status": {
        "type": "string",
        "enum": ["complete", "no_signal", "source_gap"]
      },
      "summary": {
        "type": "string",
        "maxLength": 300
      },
      "material_findings": {
        "type": "array",
        "maxItems": 5,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "problem",
            "reusable_pattern",
            "proposed_solution",
            "dedupe_key",
            "owner_surface",
            "evidence_refs",
            "confidence",
            "recovery_eligible"
          ],
          "properties": {
            "problem": {"type": "string", "maxLength": 240},
            "reusable_pattern": {"type": "string", "maxLength": 300},
            "proposed_solution": {"type": "string", "maxLength": 300},
            "dedupe_key": {
              "type": "string",
              "minLength": 3,
              "maxLength": 96,
              "pattern": "^[a-z0-9]+(?:_[a-z0-9]+){1,7}$"
            },
            "owner_surface": {
              "type": "string",
              "enum": ["skill", "policy", "docs", "automation", "hook", "validator", "feature", "ticket", "none"]
            },
            "evidence_refs": {
              "type": "array",
              "minItems": 1,
              "maxItems": 8,
              "items": {"type": "string", "maxLength": 240}
            },
            "confidence": {
              "type": "string",
              "enum": ["high", "medium", "low"]
            },
            "recovery_eligible": {"type": "boolean"}
          }
        }
      },
      "source_gaps": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "reason", "input_ref"],
          "properties": {
            "id": {"type": "string", "maxLength": 160},
            "reason": {"type": "string", "maxLength": 240},
            "input_ref": {"type": "string", "maxLength": 500}
          }
        }
      },
      "escalation": {
        "type": "object",
        "additionalProperties": false,
        "required": ["decision", "reason_codes"],
        "properties": {
          "decision": {
            "type": "string",
            "enum": ["none", "dogfood", "recovery_candidate", "source_gap"]
          },
          "reason_codes": {
            "type": "array",
            "items": {"type": "string", "maxLength": 160}
          }
        }
      }
    }
  }
}
