# Managed template for ~/.codex/config.toml.
# Do not put machine-local secrets or trust entries here.
# `install.sh` renders this template using values from:
#   - process env (preferred; works with `doppler run -- ...`)
#   - ~/.farplane/config.toml (private fallback/cache)
#   - ~/.codex/config.local.toml (optional, appended verbatim)

model = "gpt-5.5"
model_provider = "openai"
approval_policy = "never"
sandbox_mode = "danger-full-access"
model_reasoning_effort = "medium"
notify = ["python3", "__CODEX_HOME__/bin/notify.py"]
approvals_reviewer = "user"
service_tier = "fast"

[features]
multi_agent = true

[env]
FARPLANE_HOME = "__CODEX_HOME__"
FARPLANE_IMPL_HOOK = "1"
FARPLANE_CONVEX_SITE_URL = "__FARPLANE_CONVEX_SITE_URL__"
FARPLANE_TELEMETRY_TOKEN = "__FARPLANE_TELEMETRY_TOKEN__"
FARPLANE_CONSOLE_KEY = "__FARPLANE_CONSOLE_KEY__"
# Optional explicit Codex hook telemetry endpoint. Normally leave this unset:
# hooks/farplane_console_ping.py posts to FARPLANE_CONVEX_SITE_URL/telemetry/hooks.
# Optional hook telemetry endpoint. Prefer runtime env or Farplane UI-managed
# fallback/cache values; install.sh renders them here as Codex adapter config.
# FARPLANE_TELEMETRY_HOOKS_URL = "https://your-backend.example.com/telemetry/hooks"
# Skill graph heat controls. The generated skill graph reads local
# `.farplane/events/*.jsonl` and uses these values to decide its default hot
# skill window and top-N view.
FARPLANE_SKILL_HEAT_WINDOW_DAYS = "30"
FARPLANE_SKILL_HEAT_RECENT_DAYS = "7"
FARPLANE_SKILL_HEAT_TOP_N = "25"
# Comma-separated event types counted as skill heat.
FARPLANE_SKILL_HEAT_EVENT_TYPES = "control_surface_detected,hook_result,skill_requested"
# Shared prose-accountant ceilings. Closed Mermaid, exact image/video embed
# lines, and a trailing link-only References/Citations section are reported but
# excluded. The word limit is hard; the line limit requests one compression pass.
FARPLANE_FINAL_RESPONSE_MAX_PROSE_WORDS = "500"
FARPLANE_FINAL_RESPONSE_MAX_PROSE_LINES = "20"
# Phone reminder / LiveKit voice-agent settings. Store real values in
# runtime env when possible, optionally injected with Doppler. Private
# ~/.farplane/config.toml may cache fallback/bootstrap values; install.sh
# renders them here for Codex subprocesses only when env does not provide them.
LIVEKIT_URL = "__LIVEKIT_URL__"
LIVEKIT_API_KEY = "__LIVEKIT_API_KEY__"
LIVEKIT_API_SECRET = "__LIVEKIT_API_SECRET__"
LIVEKIT_PHONE_NUMBER = "__LIVEKIT_PHONE_NUMBER__"
LIVEKIT_PHONE_NUMBER_ID = "__LIVEKIT_PHONE_NUMBER_ID__"
LIVEKIT_SIP_DISPATCH_RULE_ID = "__LIVEKIT_SIP_DISPATCH_RULE_ID__"
LIVEKIT_SIP_TRUNK_ID = "__LIVEKIT_SIP_TRUNK_ID__"
LIVEKIT_SIP_NUMBER = "__LIVEKIT_SIP_NUMBER__"
LIVEKIT_SIP_OUTBOUND_ADDRESS = "__LIVEKIT_SIP_OUTBOUND_ADDRESS__"
LIVEKIT_SIP_AUTH_USERNAME = "__LIVEKIT_SIP_AUTH_USERNAME__"
LIVEKIT_SIP_AUTH_PASSWORD = "__LIVEKIT_SIP_AUTH_PASSWORD__"
TELNYX_API_KEY = "__TELNYX_API_KEY__"
FISH_API_KEY = "__FISH_API_KEY__"
FISH_AUDIO_REFERENCE_ID = "__FISH_AUDIO_REFERENCE_ID__"
FISH_AUDIO_MODEL = "__FISH_AUDIO_MODEL__"
FISH_AUDIO_LATENCY_MODE = "__FISH_AUDIO_LATENCY_MODE__"
FARPLANE_REMINDER_PHONE = "__FARPLANE_REMINDER_PHONE__"
FARPLANE_PHONE_REMINDER_AGENT_NAME = "__FARPLANE_PHONE_REMINDER_AGENT_NAME__"
# Automation cadence lives in `farplane/automations.toml` so Farplane UI can
# render and update full Codex automation configs before syncing the Codex
# automation record.
# Optional explicit force-on for Farplane hook behavior. Live Codex hooks now
# capture user turns and Stop telemetry only.

[sandbox_workspace_write]
network_access = false
exclude_tmpdir_env_var = false
exclude_slash_tmp = false

[mcp_servers.convex]
command = "npx"
args = ["-y", "convex", "mcp", "start"]

[mcp_servers.sequential-thinking]
command = "npx"
args = ["-y", "@modelcontextprotocol/server-sequential-thinking"]

# Add your real Ref key locally only.
[mcp_servers.Ref]
url = "https://api.ref.tools/mcp?apiKey=__REF_API_KEY__"

[mcp_servers.deepwiki]
url = "https://mcp.deepwiki.com/mcp"

[mcp_servers.grep]
url = "https://mcp.grep.app"

[agents]
max_threads = 6
max_depth = 1

[agents.asset-generator]
description = "Asset generation subagent for game/app art using Replicate MCP (and Fal AI references). Generates multiple options, saves them to assets/generated/, and reports choices."
config_file = "agents/asset-generator.toml"

[agents.bash-operator]
description = "Specialist shell operator for filesystem/build/debug command workflows. Use proactively for multi-step terminal tasks that need efficient command selection, safety checks, verification, and rollback notes."
config_file = "agents/bash-operator.toml"

[agents.reviewer]
description = "Independent rubric reviewer for ticketed plans, implementations, evidence bundles, skills, prompts, docs, evals, and completion receipts. Use proactively before material completion claims."
config_file = "agents/reviewer.toml"

[agents.goal-drift-reviewer]
description = "Read-only Goal Packet drift reviewer that compares ticket, program, progress, and the current continuation claim."
config_file = "agents/goal-drift-reviewer.toml"

[agents.documentation-maintainer]
description = "Meta-agent responsible for keeping the system's documentation (README, CHANGELOG) accurate and up-to-date by synthesizing recent research and project progress."
config_file = "agents/documentation-maintainer.toml"

[agents.documentation-searcher]
description = "Specialist agent for fetching and synthesizing official documentation from specific URLs using Ref tools."
config_file = "agents/documentation-searcher.toml"

[agents.explore]
description = "Combined agent for exploring local codebases. Handles locating files, analyzing implementations, and finding code patterns. Use for WHERE, HOW, or SHOW ME questions."
config_file = "agents/explore.toml"

[agents.frontend-designer]
description = "Expert UI/UX designer for both app interfaces (shadcn, AI Elements) and cinematic landing pages (scroll narratives, WebGL). Creates distinctive designs that avoid AI-generated aesthetics."
config_file = "agents/frontend-designer.toml"

[agents.librarian]
description = "Agent for exploring external codebases and patterns. Handles broad GitHub searches (DISCOVER) and deep-dives into specific repositories."
config_file = "agents/librarian.toml"

[agents.qa-tester]
description = "QA subagent that plans and executes tests. Uses the Codex in-app Browser for operated proof and Playwright for stable regression coverage."
config_file = "agents/qa-tester.toml"

[agents.repent-scribe]
description = "Post-fix repent lesson scribe that writes LESSONS rows and optional Notion improvement proposals."
config_file = "agents/repent-scribe.toml"

[agents.hardcase-curator]
description = "Sanitized hard-case curator for corrected repent episodes that may become eval or training-data samples."
config_file = "agents/hardcase-curator.toml"

[notice]
hide_rate_limit_model_nudge = true
hide_full_access_warning = true

[notice.model_migrations]
"gpt-5.3-codex" = "gpt-5.5"
"gpt-5.4" = "gpt-5.5"

# Keep machine-specific trust entries local only in `~/.codex/config.local.toml`.

[tui]
status_line = ["model-with-reasoning", "context-remaining", "current-dir", "five-hour-limit", "session-id"]
